      "dietaryProfile": {
        "dietType": "balanced",
        "allergies": [],
        "dislikes": []
      }
    },
    "now": "2026-11-18T13:15:00Z",
    "flags": { "writeCards": true },
    "pro": {
      "expectTools": ["log_food_item"],
      "expectProposal": "food",
      "toolArgs": { "log_food_item": { "items": "\"count\":2" } }
