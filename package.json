{
  "name": "ocrecipes",
  "main": "client/index.js",
  "version": "1.0.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "preexpo:dev": "tsx scripts/check-api-domain.ts",
    "expo:dev": "npx expo start --tunnel",
    "server:dev": "NODE_ENV=development tsx watch server/index.ts",
    "expo:start:static:build": "npx expo start --no-dev --minify",
    "expo:static:build": "node scripts/build.js",
    "server:build": "esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=server_dist --alias:@shared=./shared",
    "server:prod": "NODE_ENV=production node server_dist/index.js",
    "predb:push": "tsx scripts/check-timestamptz-migration.ts",
    "ai:smoke": "npx tsx scripts/ai-smoke.ts",
    "db:push": "drizzle-kit push",
    "lint": "ESLINT_NO_TYPE_AWARE= npx expo lint && node scripts/check-react-compiler-bailouts.js",
    "lint:fix": "npx expo lint --fix",
    "lint:suppress": "ESLINT_NO_TYPE_AWARE= eslint . --suppress-rule @typescript-eslint/no-floating-promises --suppress-rule @typescript-eslint/no-misused-promises --suppress-rule @typescript-eslint/await-thenable --suppress-rule @typescript-eslint/require-await --suppress-rule @typescript-eslint/no-implied-eval --suppress-rule @typescript-eslint/prefer-promise-reject-errors",
    "lint:suppress:prune": "ESLINT_NO_TYPE_AWARE= eslint . --prune-suppressions",
    "lint:suppress:check": "ESLINT_NO_TYPE_AWARE= eslint . --prune-suppressions && git diff --exit-code -- eslint-suppressions.json",
    "lint:a11y": "node scripts/check-accessibility.js",
    "check:types": "tsc --noEmit",
    "check:types:incremental": "mkdir -p node_modules/.cache && tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc-precommit.tsbuildinfo",
    "ci:failed-logs": "bash scripts/ci-failed-logs.sh",
    "build:copilot-instructions": "tsx scripts/build-copilot-instructions.ts .github/copilot-instructions.md",
    "build:copilot-instructions:check": "tsx scripts/build-copilot-instructions.ts --check .github/copilot-instructions.md",
    "build:domain-map": "tsx scripts/build-domain-map.ts .claude/hooks/lib/domain-map.sh",
    "build:domain-map:check": "tsx scripts/build-domain-map.ts --check .claude/hooks/lib/domain-map.sh",
    "build:generated:check": "npm run build:copilot-instructions:check && npm run build:domain-map:check",
    "check:format": "prettier --check \"**/*.{js,ts,tsx,mts,css,json}\"",
    "format": "prettier --write \"**/*.{js,ts,tsx,mts,css,json}\"",
    "test": "vitest",
    "test:run": "vitest run",
    "test:unit": "vitest run --exclude 'server/storage/__tests__/**'",
    "test:integration": "vitest run server/storage/__tests__/",
    "test:integration:http": "vitest run --config vitest.integration.config.mts",
    "test:coverage": "vitest run --coverage",
    "test:coverage:ci": "vitest run --coverage --coverage.thresholds.autoUpdate=false",
    "coverage:ratchet": "tsx scripts/coverage-ratchet.ts",
    "test:mutation": "stryker run",
    "mutation:explore": "node scripts/mutation-explore.mjs",
    "prepare": "bash scripts/install-git-hooks.sh",
    "postinstall": "patch-package",
    "preandroid": "tsx scripts/check-api-domain.ts",
    "android": "expo run:android",
    "preios": "tsx scripts/check-api-domain.ts",
    "ios": "expo run:ios",
    "update:preview": "CI=1 EXPO_PUBLIC_DOMAIN=https://api.ocrecipes.com EXPO_PUBLIC_SENTRY_DSN=https://bf62b005c5085c50b08ad690c613ded4@o4511605735489536.ingest.us.sentry.io/4511605740142592 sh -c 'ok=0; for a in \"$@\"; do case \"$a\" in --message|--message=*) ok=1 ;; --platform|--platform=*) echo \"error: do not pass --platform; this script always publishes both native targets via --platform all\" >&2; exit 1 ;; esac; done; if [ \"$ok\" != \"1\" ]; then echo \"error: --message is required. Usage: npm run update:preview -- --message \\\"your message\\\"\" >&2; exit 1; fi; exec eas update --branch preview --platform all \"$@\"' --",
    "update:production": "CI=1 EXPO_PUBLIC_DOMAIN=https://api.ocrecipes.com EXPO_PUBLIC_SENTRY_DSN=https://bf62b005c5085c50b08ad690c613ded4@o4511605735489536.ingest.us.sentry.io/4511605740142592 sh -c 'ok=0; for a in \"$@\"; do case \"$a\" in --message|--message=*) ok=1 ;; --platform|--platform=*) echo \"error: do not pass --platform; this script always publishes both native targets via --platform all\" >&2; exit 1 ;; esac; done; if [ \"$ok\" != \"1\" ]; then echo \"error: --message is required. Usage: npm run update:production -- --message \\\"your message\\\"\" >&2; exit 1; fi; exec eas update --branch production --platform all \"$@\"' --",
    "seed:recipes": "tsx server/scripts/seed-recipes.ts",
    "cleanup:seeds": "tsx server/scripts/cleanup-seed-recipes.ts",
    "cleanup:retention": "tsx server/scripts/cleanup-retention.ts",
    "migrate:images-r2": "tsx server/scripts/migrate-images-to-r2.ts",
    "preview:art-direction": "tsx server/scripts/preview-art-direction.ts",
    "backfill:recipe-images": "tsx server/scripts/backfill-recipe-images.ts",
    "backfill:community-nutrition": "tsx server/scripts/backfill-community-nutrition.ts",
    "backfill:email-verified": "tsx server/scripts/backfill-email-verified.ts",
    "e2e": "maestro test -e USERNAME=${USERNAME:-testuser} -e PASSWORD=${PASSWORD:-ocr-e2e-maestro-Kq7v2x} --debug-output e2e/maestro-output --flatten-debug-output e2e/",
    "e2e:regression": "maestro test -e USERNAME=${USERNAME:-testuser} -e PASSWORD=${PASSWORD:-ocr-e2e-maestro-Kq7v2x} --include-tags regression --debug-output e2e/maestro-output --flatten-debug-output e2e/",
    "e2e:smoke": "maestro test -e USERNAME=${USERNAME:-testuser} -e PASSWORD=${PASSWORD:-ocr-e2e-maestro-Kq7v2x} --include-tags smoke --debug-output e2e/maestro-output --flatten-debug-output e2e/",
    "eval:coach": "npx tsx evals/runner.ts",
    "eval:recipe-chat": "npx tsx evals/runner-recipe-chat.ts",
    "eval:meal-suggestions": "npx tsx evals/runner-meal-suggestions.ts",
    "eval:recipe-generation": "EVAL_SKIP_IMAGE_GENERATION=true npx tsx evals/runner-recipe-generation.ts",
    "eval:inspired": "npx tsx evals/runner-inspired-suggestions.ts",
    "eval:photo": "npx tsx evals/runner-photo-analysis.ts",
    "eval:compare": "npx tsx scripts/ci/eval-compare.ts",
    "eval:paired": "npx tsx scripts/ci/eval-compare.ts --paired",
    "eval:all": "npm run eval:coach && npm run eval:recipe-chat && npm run eval:meal-suggestions && npm run eval:recipe-generation && npm run eval:inspired",
    "generate:icons": "npx tsx scripts/generate-ingredient-icons.ts",
    "preflight": "bash scripts/preflight.sh",
    "preflight:fast": "bash scripts/preflight.sh --fast"
  },
  "dependencies": {
    "@apple/app-store-server-library": "^2.0.0",
    "@aws-sdk/client-s3": "^3.1063.0",
    "@expo-google-fonts/nunito": "^0.4.2",
    "@expo-google-fonts/poppins": "^0.4.1",
    "@expo/vector-icons": "^15.0.2",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@infinitered/react-native-mlkit-text-recognition": "^5.0.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-community/slider": "5.2.1",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/core": "^7.13.5",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@react-navigation/native-stack": "^7.3.16",
    "@sentry/node": "^10.65.0",
    "@sentry/react-native": "~8.28.0",
    "@tanstack/query-async-storage-persister": "^5.101.0",
    "@tanstack/react-query": "^5.90.7",
    "@tanstack/react-query-persist-client": "^5.101.0",
    "babel-preset-expo": "~58.0.0",
    "bcrypt": "^6.0.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.7.1",
    "expo": "^58.0.21",
    "expo-apple-authentication": "~58.0.2",
    "expo-application": "~58.1.2",
    "expo-blur": "~58.0.5",
    "expo-build-properties": "~58.0.11",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.14",
    "expo-dev-client": "~58.0.17",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.7",
    "expo-iap": "^6.3.0",
    "expo-image": "~58.0.18",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.15",
    "expo-notifications": "~58.1.7",
    "expo-secure-store": "~58.0.2",
    "expo-server-sdk": "^6.1.0",
    "expo-speech": "~58.0.3",
    "expo-speech-recognition": "~58.0.1",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.19",
    "expo-web-browser": "~58.0.7",
    "express": "^5.0.1",
    "express-rate-limit": "^8.5.2",
    "google-auth-library": "^10.6.2",
    "helmet": "^8.2.0",
    "jose": "^6.2.12",
    "jsonwebtoken": "^9.0.3",
    "minisearch": "^7.2.0",
    "multer": "^2.5.0",
    "node-cron": "^4.2.1",
    "openai": "^6.39.0",
    "p-limit": "^7.3.0",
    "p-retry": "^7.1.1",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-confetti-cannon": "^1.5.2",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-nitro-image": "^0.15.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-vision-camera": "^5.2.3",
    "react-native-vision-camera-barcode-scanner": "^5.2.3",
    "react-native-worklets": "0.13.0",
    "resend": "^6.14.0",
    "tsx": "^4.22.3",
    "zod": "^3.25.76",
    "zod-validation-error": "^3.5.4"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.98.0",
    "@babel/core": "^7.29.7",
    "@babel/plugin-syntax-jsx": "^7.28.6",
    "@babel/preset-typescript": "^7.28.5",
    "@expo/ngrok": "^4.1.3",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@testing-library/react": "^16.3.2",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "24.10.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.20.0",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.12",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "^0.31.4",
    "esbuild": "^0.28.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-node": "^0.3.9",
    "eslint-plugin-prettier": "^5.5.5",
    "fast-check": "^4.9.0",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "lint-staged": "^16.4.0",
    "patch-package": "^8.0.1",
    "pino-pretty": "^13.1.3",
    "prettier": "3.6.2",
    "railway": "^3.13.1",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5",
    "supertest": "^7.2.2",
    "ts-morph": "^28.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.59.4",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "body-parser": "^2.4.0",
    "brace-expansion@^1.0.0": "^1.1.18",
    "brace-expansion@^2.0.0": "^2.1.4",
    "brace-expansion@^5.0.0": "^5.0.9",
    "decode-uri-component": "^0.5.1",
    "eslint-plugin-react-hooks": {
      "zod-validation-error": "^4.0.2"
    },
    "fast-uri": "^3.1.9",
    "form-data": "^4.0.6",
    "ip-address": "^10.7.4",
    "js-yaml@^3.0.0": "^3.15.2",
    "js-yaml@^4.0.0": "^4.3.2",
    "nanoid": "^3.3.18",
    "postcss": "^8.5.25",
    "qs": "^6.16.1",
    "shell-quote": "^1.9.0",
    "tar": "^7.5.19",
    "undici": "^7.30.1"
  },
  "lint-staged": {
    "*.{ts,tsx,mts}": [
      "env ESLINT_NO_TYPE_AWARE=1 eslint --fix",
      "prettier --write"
    ],
    "client/**/*.tsx": [
      "node scripts/check-accessibility.js",
      "node scripts/check-hardcoded-colors.js",
      "node scripts/check-bottomsheet-backhandler.js"
    ],
    "client/components/**/__tests__/*.test.tsx": [
      "node scripts/check-jsdom-pragma.js"
    ],
    "server/storage/*.ts": [
      "node scripts/check-idor-storage.js"
    ],
    "evals/datasets/*.json": [
      "node scripts/check-eval-dataset-secrets.js"
    ],
    "docs/solutions/**/*.md": [
      "node scripts/check-solution-frontmatter.js"
    ],
    "docs/rules/*.md": [
      "node scripts/check-rules-file-size.js"
    ],
    ".claude/skills/**/SKILL.md": [
      "node scripts/check-skill-positional-params.js"
    ],
    "{.claude/hooks/**/*.sh,todos/**/*.md}": [
      "node scripts/check-claim-staleness.js"
    ],
    "*.{js,md}": [
      "prettier --write"
    ],
    "*.{json,css}": [
      "prettier --write"
    ]
  },
  "private": true
}
