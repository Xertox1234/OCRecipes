     @Override
     public void onPermissionRequest(final PermissionRequest request) {
 
+        // OCRecipes: the recipe-import WebView loads untrusted pages and must not
+        // reach device capabilities. Never grant camera/mic (the stock code grants
+        // them silently when the app already holds CAMERA/RECORD_AUDIO) and never
+        // raise an OS permission prompt for a page.
+        for (String requestedResource : request.getResources()) {
+            if (requestedResource.equals(PermissionRequest.RESOURCE_VIDEO_CAPTURE)
+                    || requestedResource.equals(PermissionRequest.RESOURCE_AUDIO_CAPTURE)
+                    || (requestedResource.equals(PermissionRequest.RESOURCE_PROTECTED_MEDIA_ID)
+                        && !mAllowsProtectedMedia)) {
+                request.deny();
+                return;
+            }
+        }
+
