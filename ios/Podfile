source 'https://cdn.cocoapods.org/'

require File.join(File.dirname(`node --print "require.resolve('expo/package.json')"`), "scripts/autolinking")
require File.join(File.dirname(`node --print "require.resolve('react-native/package.json')"`), "scripts/react_native_pods")

require 'json'
podfile_properties = JSON.parse(File.read(File.join(__dir__, 'Podfile.properties.json'))) rescue {}

def ccache_enabled?(podfile_properties)
  # Environment variable takes precedence
  return ENV['USE_CCACHE'] == '1' if ENV['USE_CCACHE']
  
  # Fall back to Podfile properties
  podfile_properties['apple.ccacheEnabled'] == 'true'
end

ENV['RCT_NEW_ARCH_ENABLED'] ||= '0' if podfile_properties['newArchEnabled'] == 'false'
ENV['EX_DEV_CLIENT_NETWORK_INSPECTOR'] ||= podfile_properties['EX_DEV_CLIENT_NETWORK_INSPECTOR']
ENV['RCT_USE_RN_DEP'] ||= '1' if podfile_properties['ios.buildReactNativeFromSource'] != 'true' && podfile_properties['newArchEnabled'] != 'false'
ENV['RCT_USE_PREBUILT_RNCORE'] ||= '1' if podfile_properties['ios.buildReactNativeFromSource'] != 'true' && podfile_properties['newArchEnabled'] != 'false'
platform :ios, podfile_properties['ios.deploymentTarget'] || '15.1'

prepare_react_native_project!

target 'OCRecipes' do
  use_expo_modules!

  if ENV['EXPO_USE_COMMUNITY_AUTOLINKING'] == '1'
    config_command = ['node', '-e', "process.argv=['', '', 'config'];require('@react-native-community/cli').run()"];
  else
    config_command = [
      'npx',
      'expo-modules-autolinking',
      'react-native-config',
      '--json',
      '--platform',
      'ios'
    ]
  end

  config = use_native_modules!(config_command)

  use_frameworks! :linkage => podfile_properties['ios.useFrameworks'].to_sym if podfile_properties['ios.useFrameworks']
  use_frameworks! :linkage => ENV['USE_FRAMEWORKS'].to_sym if ENV['USE_FRAMEWORKS']

  use_react_native!(
    :path => config[:reactNativePath],
    :hermes_enabled => podfile_properties['expo.jsEngine'] == nil || podfile_properties['expo.jsEngine'] == 'hermes',
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/..",
    :privacy_file_aggregation_enabled => podfile_properties['apple.privacyManifestAggregationEnabled'] != 'false',
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      :ccache_enabled => ccache_enabled?(podfile_properties),
    )

    # fmt 11.0.2 (pinned by React Native via third-party-podspecs/fmt.podspec)
    # does not compile under Xcode 26 / Apple clang 21. clang tightened its
    # consteval rules, and fmt's FMT_STRING compile-time validation now trips
    # "call to consteval function ... is not a constant expression" — 5 errors in
    # fmt/format-inl.h that kill a clean build ~12s in, before any app code is
    # reached. Nothing in this project causes it; the toolchain moved.
    #
    # fmt gives every other feature macro an external escape hatch
    # (`#ifdef FMT_USE_CONSTEXPR` / `FMT_USE_CONCEPTS` /
    # `FMT_USE_NONTYPE_TEMPLATE_ARGS`, each "// Use the provided definition"),
    # but the consteval chain in base.h was missed — it #defines
    # FMT_USE_CONSTEVAL unconditionally, so the header always wins and a
    # `-DFMT_USE_CONSTEVAL=0` build setting can NOT reach it. Both halves below
    # are load-bearing: add the missing guard, then force the macro off through
    # it. Patching only one has no effect.
    #
    # Effect: format-string validation drops from compile-time to runtime. RN's
    # fmt usage is diagnostic logging with literal format strings, so no
    # meaningful checking is lost here.
    #
    # REMOVE THIS when fmt moves past 11.0.2 or RN unpins it — but verify the
    # removal with `rm -rf ios/Pods && pod install`, NOT with fresh DerivedData.
    # This hook rewrites base.h *inside the sandbox*, and CocoaPods re-extracts
    # a pod only when its spec checksum changes. So deleting the hook and
    # re-running `pod install` leaves the already-patched header on disk: a
    # DerivedData-clean build passes against a still-patched header, and only
    # EAS — which pod-installs into a pristine sandbox — fails, with the
    # original 5 consteval errors and no obvious link back to this deletion.
    # NOTE: CocoaPods installs pod headers read-only (0444), so this must chmod
    # before writing and restore the mode after. Everything is wrapped in a
    # rescue because an exception raised here aborts the WHOLE post_install
    # hook — silently skipping the MLKit and VisionCamera fixes below, which
    # breaks simulator and Release builds in ways that look unrelated to fmt.
    begin
      fmt_base_h = File.join(installer.sandbox.root, 'fmt', 'include', 'fmt', 'base.h')
      if File.exist?(fmt_base_h)
        fmt_marker = 'FMT_USE_CONSTEVAL 0  // patched by Podfile: Xcode 26 / clang 21'
        fmt_anchor = '#if !defined(__cpp_lib_is_constant_evaluated)'
        fmt_content = File.read(fmt_base_h)
        if fmt_content.include?(fmt_marker)
          # already patched (pod install re-run against an unchanged sandbox)
        elsif fmt_content.include?(fmt_anchor)
          fmt_patched = fmt_content.sub(fmt_anchor, <<~GUARD.chomp)
            #define #{fmt_marker}
            #ifdef FMT_USE_CONSTEVAL
            // Use the provided definition.
            #elif !defined(__cpp_lib_is_constant_evaluated)
          GUARD
          fmt_mode = File.stat(fmt_base_h).mode
          begin
            File.chmod(0o644, fmt_base_h)
            File.write(fmt_base_h, fmt_patched)
          ensure
            File.chmod(fmt_mode, fmt_base_h)
          end
          Pod::UI.puts '[fmt] patched base.h to disable consteval (Xcode 26 / clang 21)'
        else
          # Warn, never raise: a silent no-op reappears later as an inscrutable
          # 5-error fmt build failure with no pointer back to this hook.
          Pod::UI.warn '[fmt] consteval anchor not found in base.h — fmt may have ' \
                       'changed. If a clean build fails on consteval in ' \
                       'format-inl.h, update or remove this Podfile patch.'
        end
      else
        # Same reasoning as the anchor-missing warn above. A pod rename,
        # use_frameworks!, a modular-headers change, or RN vendoring fmt
        # elsewhere would move this path and skip the patch in total silence.
        Pod::UI.warn "[fmt] base.h not found at #{fmt_base_h} — the pod layout " \
                     'may have changed, so the consteval patch was NOT applied. ' \
                     'Expect a clean build to fail in fmt/format-inl.h.'
      end
    rescue => e
      Pod::UI.warn "[fmt] could not apply the consteval patch (#{e.class}: #{e.message}). " \
                   'A clean build will fail in fmt/format-inl.h until this is resolved.'
    end

    # iOS 26 simulators are arm64-only but MLKit ships fat binaries with arm64
    # tagged for device. Strip EXCLUDED_ARCHS so xcodebuild discovers arm64
    # simulators, then re-tag MLKit binaries for simulator platform.
    installer.pods_project.build_configurations.each do |config|
      config.build_settings.delete('EXCLUDED_ARCHS[sdk=iphonesimulator*]')
    end
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings.delete('EXCLUDED_ARCHS[sdk=iphonesimulator*]')
      end
    end
    Dir.glob(File.join(installer.sandbox.root, 'Target Support Files', '**', '*.xcconfig')).each do |xcconfig_path|
      content = File.read(xcconfig_path)
      cleaned = content.gsub(/EXCLUDED_ARCHS\[sdk=iphonesimulator\*\]\s*=\s*arm64\n?/, '')
      File.write(xcconfig_path, cleaned) if content != cleaned
    end

    # Add a pre-compile Run Script phase to OCRecipes that patches MLKit frameworks
    # for the current build platform — simulator needs arm64 tagged as iOS-simulator,
    # device needs arm64 tagged as iOS. This replaces the unconditional pod-install-time
    # patch so both simulator and device builds work without re-running pod install.
    script_path = File.join(installer.sandbox.root, '..', '..', 'scripts', 'patch-mlkit-simulator.py')
    if File.exist?(script_path)
      installer.aggregate_targets.each do |agg|
        next unless agg.name == 'Pods-OCRecipes'
        project = agg.user_project
        project.targets.each do |target|
          next unless target.name == 'OCRecipes'
          phase_name = '[MLKit] Patch for platform'
          next if target.build_phases.any? { |p| p.respond_to?(:name) && p.name == phase_name }
          phase = target.new_shell_script_build_phase(phase_name)
          # Declare the phase intentionally always-out-of-date so Xcode stops
          # warning about "ambiguous dependencies". This script genuinely must
          # run every build (it re-tags MLKit binaries per platform), so there
          # are no stable input/output files to declare instead.
          phase.always_out_of_date = "1"
          phase.shell_script = <<~SHELL
            SCRIPT="${SRCROOT}/../scripts/patch-mlkit-simulator.py"
            PODS="${SRCROOT}/Pods"
            if [ -f "$SCRIPT" ] && [ -d "$PODS" ]; then
              if [ "$PLATFORM_NAME" = "iphonesimulator" ]; then
                python3 "$SCRIPT" "$PODS"
              else
                python3 "$SCRIPT" --reverse "$PODS"
              fi
            fi
          SHELL
          # Move before Compile Sources so frameworks are correct before linking
          compile_idx = target.build_phases.index { |p| p.is_a?(Xcodeproj::Project::Object::PBXSourcesBuildPhase) }
          if compile_idx && compile_idx > 0
            target.build_phases.move_from(target.build_phases.index(phase), compile_idx)
          end
          project.save
        end
      end
    end

    # Swift 6.2 (Xcode 26) ICE with nitrogen-generated C++/Swift interop
    # (std::function capture, swiftlang/swift#76143). Manifests two ways:
    #  - whole-module batch ICE  -> SWIFT_COMPILATION_MODE = singlefile
    #  - LLVM optimizer crash in the Release archive ("Global is external, but
    #    doesn't have external or weak linkage" in the verify pass) -> -Onone
    # Local `expo run:ios` is Debug (-Onone) so it never hits the optimizer
    # crash; EAS's Release archive does. Apply to ALL VisionCamera-family
    # targets so the main VisionCamera lib (not just the barcode scanner) is
    # covered. Runtime cost is negligible — the heavy work is native AVFoundation.
    installer.pods_project.targets.each do |target|
      next unless target.name.start_with?('VisionCamera')
      target.build_configurations.each do |config|
        config.build_settings['SWIFT_COMPILATION_MODE'] = 'singlefile'
        config.build_settings['SWIFT_VERSION'] = '5'
        config.build_settings['SWIFT_OPTIMIZATION_LEVEL'] = '-Onone'
      end
    end
  end
end
